# OpenTermius Gateway Environment Variables

# 1. Server & Gateway Web UI
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
WEB_PORT=5174
GATEWAY_HOST=localhost
APP_ENV=production # development | production

# 2. Security & Encryption Secrets (use `openssl rand -hex 32`)
# APP_SECRET encrypts sensitive settings at rest (e.g. SMTP password in PostgreSQL)
APP_SECRET=change-this-to-a-secure-random-32-byte-hex-key
JWT_SECRET=change-this-to-a-very-long-and-secure-secret-token

# 3. Default Gateway Admin Account (seeded on first startup)
DEFAULT_ADMIN_EMAIL=admin@opentermius.local
DEFAULT_ADMIN_PASSWORD=OpenTermius2026!
DEFAULT_ADMIN_NAME=Gateway Admin

# 4. Registration & Access Policy
# false = invite-only (admin invites team members via Gateway Web); true = allow public self-registration
ALLOW_PUBLIC_REGISTER=false

# 5. Reverse Proxy, CORS & Vite Preview Hosts
# Leave CORS_ALLOWED_ORIGINS empty to allow Desktop/Mobile clients & reverse-proxy domains,
# or comma-separate allowed origins (e.g. https://webgw.example.com,http://localhost:5174)
CORS_ALLOWED_ORIGINS=
# Leave ALLOWED_HOSTS empty to allow any reverse-proxy domain in Vite preview,
# or comma-separate specific hostnames (e.g. webgw.example.com,localhost)
ALLOWED_HOSTS=
# Optional internal target for Vite /api proxy (defaults to http://127.0.0.1:${SERVER_PORT})
API_PROXY_TARGET=
# Optional external API base URL override for Gateway Web (defaults to same-origin /api/v1)
VITE_API_BASE=

# 6. Database (PostgreSQL)
DATABASE_URL=postgres://opentermius:opentermius@localhost:5432/opentermius?sslmode=disable
