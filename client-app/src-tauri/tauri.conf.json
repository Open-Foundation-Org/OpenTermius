{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "opentermius",
  "version": "0.6.1",
  "identifier": "com.opentermius.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenTermius",
        "width": 1150,
        "height": 750,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCQkI0NzU5MDlFMTc3NTUKUldSVmQrRUpXVWU3dTArWGtDaEgyS2NBczNUM1hnTVJMSmxKUjJmQ2dwTlNPeitUa05lRGRlWVcK",
      "endpoints": [
        "https://github.com/Open-Foundation-Org/OpenTermius/releases/latest/download/latest.json"
      ]
    }
  }
}
